# ==============================================================================
# GitProtect Staging Environment Variables (.env.example)
# Copy this file to .env before deploying: cp .env.example .env
# ==============================================================================

# Khóa chủ AES-256-GCM 256-bit dạng Hex (bắt buộc 64 ký tự hex)
GITPROTECT_AES_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Cấu hình Cơ sở dữ liệu MySQL 8.0
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=gitprotect
MYSQL_USER=gitprotect
MYSQL_PASSWORD=gitprotect_staging_pass
MYSQL_ROOT_PASSWORD=root_staging_master_pass

# Cấu hình Redis Cache & Hàng đợi quét (Queue)
REDIS_HOST=redis
REDIS_PORT=6379

# Đường dẫn Webhook Callback nhận sự kiện push từ GitHub
GITHUB_WEBHOOK_CALLBACK_URL=https://localhost/api/v1/webhooks/github

# Danh sách tên miền email doanh nghiệp hợp lệ (phục vụ kiểm toán commit author & Email Spoofing Notice)
ALLOWED_EMAIL_DOMAINS=organization.vn,gitprotect.io
